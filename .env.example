# Local development database (Docker Compose)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME"

# Auth.js v5 — generate secret: openssl rand -base64 32
# Google credentials: console.cloud.google.com → APIs & Services → Credentials
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_URL=https://yourdomain.com  # required in production

# Comma-separated list of emails that get systemRole = 'admin' on sign-in
ADMIN_EMAILS=

# Email of the dev user to target when running seed scripts
SEED_USER_EMAIL=

# Public site URL — used for metadataBase, sitemap, and robots (fallback: http://localhost:3000)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Dev only: comma-separated extra origins allowed for Next.js cross-origin dev requests
# (e.g. your machine's LAN IP for testing on a phone). Unused in production.
# DEV_ALLOWED_ORIGINS=YOUR_LAN_IP

# Telegram reminder digests (notifications slice 2)
# Bot token from @BotFather. Without it, the daily job records each delivery as failed.
TELEGRAM_BOT_TOKEN=
# Single test chat id the digest is sent to in this slice (per-user channels arrive in slice 3).
# Get yours: message the bot, then GET https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`; the cron route
# rejects any request without it. Generate: openssl rand -base64 32
CRON_SECRET=